# --- Telegram (Telethon, история каналов) ---
# Получить: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=data/secrets/telethon.session
# --- Telegram: открытый канал через веб-страницу t.me/s/<имя>, без ключей (scripts.telegram_watch) ---
# Ссылки-приглашения закрытых каналов (t.me/+...) веб-страницы с постами не имеют.
TG_WEB_CHANNEL=salstek
TG_WEB_POLL_INTERVAL=60
TG_WEB_INITIAL_PAGES=1
TG_WEB_COMPANY=salavatsteklo
# --- Telegram Bot API (новые посты собственных каналов, бот — админ канала) ---
TG_BOT_TOKEN=
# --- VK API (сервисный ключ приложения или токен сообщества/пользователя) ---
# ID приложения VK (vk.com/apps?act=manage) — ключ по ссылке: python -m scripts.vk_token
VK_APP_ID=
VK_ACCESS_TOKEN=
# Ключ администратора сообщества для публикации и ответов (wall,photos,offline); лучше — секрет компании vk_token
VK_PUBLISH_TOKEN=
VK_API_VERSION=5.199
VK_API_BASE=https://api.vk.ru/method
# --- Хранилище результатов парсинга (до подключения PostgreSQL) ---
DATA_DIR=data
# --- Модель: chatgpt_plus (по умолчанию) | mock_dev (ТЕСТОВАЯ модель для фронтенда/демо, ответы помечены) ---
AI_PROVIDER=chatgpt_plus
# --- ChatGPT Plus (Sign in with ChatGPT). OPENAI_API_KEY НЕ используется ---
CHATGPT_MODEL=
CHATGPT_CALLBACK_PORT=1455
# --- Ключ шифрования секретов (Fernet). Пусто = сгенерируется в data/secrets/master.key ---
GLASS_SECRET_KEY=
# --- PostgreSQL + pgvector (docker compose up -d db) ---
DATABASE_URL=postgresql+asyncpg://glass:glass@127.0.0.1:5433/glass
# --- REST API / Telegram Mini App ---
# Telegram ID администраторов платформы (подключение ChatGPT, доступ ко всем компаниям), через запятую
ADMIN_TELEGRAM_IDS=
# Адрес Mini App для CORS и кнопки в боте
CORS_ORIGINS=
MINI_APP_URL=
# ТОЛЬКО локальная разработка: запросы без initData идут от этого Telegram ID
API_DEV_USER_ID=
# --- MAX: токен бота (business.max.ru → Чат-боты → Настройки); лучше — секрет компании max_bot_token ---
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
# --- Агент: ограничения на один запрос пользователя и дневной лимит вызовов модели на компанию ---
AI_DAILY_CALL_LIMIT=300
AGENT_MAX_STEPS=6
AGENT_MAX_LLM_CALLS=8
AGENT_MAX_SECONDS=240
# --- RAG: локальный reranker (необязательно), например cross-encoder/mmarco-mMiniLMv2-L12-H384-v1 ---
RERANKER_MODEL=
# --- Публикация ---
SCHEDULER_INTERVAL=30
SCHEDULER_IN_API=false
# --- Изображения: локальная модель diffusers (необязательно, нужен GPU) ---
LOCAL_IMAGE_MODEL=
